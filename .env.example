# ============================================================
# JustEnough Functional MVP — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ---------- PostgreSQL ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_secure_password_here
POSTGRES_DB=justenough

# ---------- Backend ----------
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------- CORS ----------
# Comma-separated or JSON list of origins. Restrict to your actual frontend URLs.
CORS_ORIGINS=["http://localhost:3000"]

# ---------- Application ----------
APP_NAME=JustEnough Functional MVP API
DEBUG=false
LOG_LEVEL=INFO

# ---------- Seed Script ----------
# Default password for demo seed users (only used by scripts/seed_database.py)
SEED_USER_PASSWORD=CHANGE_ME_demo_password

# ---------- ML ----------
# ML_MODEL_PATH=/app/ML/just_enough_ml/demand_model.joblib
