# ==============================================================================
# JustEnough AI Demand Engine — Environment Configuration (.env.example)
# Standalone Embedded SQLite Mode (Zero External Database Setup Required)
# ==============================================================================

# Application Environment (development | staging | production)
ENVIRONMENT=development

# JWT & Security Signing Key (Required in production: generate using openssl rand -hex 32)
SECRET_KEY=dev_secret_key_change_in_production_32bytes_long

# Algorithm for JWT
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Default Evaluation Credentials
DEMO_ADMIN_EMAIL=admin@justenough.local
DEMO_ADMIN_PASSWORD=AdminSecret123!

# Database Configuration:
# - Standalone local SQLite default: sqlite:///./justenough_mvp.db
# - Vercel Serverless ephemeral path: sqlite:////tmp/justenough_mvp.db
# - Optional external PostgreSQL (if FORCE_POSTGRES=1): postgresql://user:pass@host/dbname
DATABASE_URL=sqlite:///./justenough_mvp.db

# CORS Allowed Origins (JSON array or comma-separated list)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Observability
LOG_LEVEL=INFO
DEBUG=False
